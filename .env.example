# Copia este archivo a .env y rellena con los valores de tu proyecto Supabase.
# Supabase Studio > Project Settings > API
#
# NUNCA commitees .env. La service_role key JAMÁS va en el cliente
# (solo en Edge Functions del servidor).

VITE_SUPABASE_URL=https://TU_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_publica
